# Copy to .env and fill in. Everything marked "required" must be set.

# ── Database (required) ──────────────────────────────────────────────────────
# Any Postgres 14+. With a pooler (Neon, Supabase), DATABASE_URL is the pooled
# URL and DIRECT_URL the direct one used for migrations. For hosted databases,
# append ?sslmode=require (or &sslmode=require) to encrypt the connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_not_finished"
# DIRECT_URL=""

# ── Auth (required) ──────────────────────────────────────────────────────────
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of this deployment. Optional on Vercel (falls back to the
# production domain). The GitHub OAuth callback is APP_URL/api/auth/callback/github
APP_URL="http://localhost:3000"

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (optional in development) ──────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server log instead of sent.
# RESEND_API_KEY=""
# Sender on a domain verified in Resend.
# EMAIL_FROM="Job Not Finished <notices@your-domain.com>"

# ── Weekly digest cron ───────────────────────────────────────────────────────
# 16+ random characters. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""
